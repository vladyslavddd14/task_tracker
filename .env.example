# Copy this file to ".env" and replace every "change-me" value. Never commit ".env".

# ----- Database (PostgreSQL) -----
POSTGRES_DB=tasktracker
POSTGRES_USER=tasktracker
# Avoid ';' in the password: it is placed into a connection string.
POSTGRES_PASSWORD=change-me-database-password

# ----- API -----
# Secret used to sign JWT tokens. Use a long random value (at least 32 characters), for example:
#   openssl rand -base64 48
JWT__Secret=change-me-to-a-long-random-string-of-at-least-32-characters
JWT__ExpiresMinutes=60

# ----- Demo data -----
# SEED_DEMO=true creates a demo user with realistic tasks on startup (safe to repeat).
SEED_DEMO=false
SEED_DEMO_EMAIL=demo@tasktracker.local
SEED_DEMO_PASSWORD=change-me-demo-password

# ----- Ports on the host -----
# The application is opened at http://localhost:<WEB_PORT>
WEB_PORT=8080
# PostgreSQL port published on 127.0.0.1 (used when api/web run locally).
DB_PORT=5432
